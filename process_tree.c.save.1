#include <stdio.h> #include <stdlib.h> #include <unistd.h> #include <sys/types.h> #include <sys/wait.h>
int main() { pid_t pid1, pid2;
printf("[PARENT] Started with PID: %d\n", getpid());

// 1. Fork First Child
pid1 = fork();

if (pid1 < 0) {
    perror("Fork failed for Child 1");
    exit(1);
} 
else if (pid1 == 0) {
    // --- CHILD 1 CODE BLOCK ---
    printf("  [CHILD 1] Running with PID: %d (My Parent PID: %d)\n", getpid(), getppid());
    sleep(1); // Simulate task execution
    printf("  [CHILD 1] Finished execution.\n");
    exit(0); // Exit immediately so Child 1 doesn't fork Child 2
}

// 2. Fork Second Child (Only Parent executes this)
pid2 = fork();

if (pid2 < 0) {
    perror("Fork failed for Child 2");
    exit(1);
} 
else if (pid2 == 0) {
    // --- CHILD 2 CODE BLOCK ---
    printf("  [CHILD 2] Running with PID: %d (My Parent PID: %d)\n", getpid(), getppid());
    sleep(2); // Simulate task execution
    printf("  [CHILD 2] Finished execution.\n");
    exit(0); // Exit immediately
}

// --- PARENT CLEANUP ---
// Wait for both children to terminate to avoid zombie processes
wait(NULL);
wait(NULL);

printf("[PARENT] Both children have finished. Program exiting.\n");
return 0;}

